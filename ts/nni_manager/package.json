    "@types/chai-as-promised": "8.0.2",
    "@types/express": "5.0.6",
    "@types/express-ws": "3.0.6",
    "@types/http-proxy": "1.17.17",
    "@types/js-yaml": "4.0.9",
    "@types/lockfile": "1.0.4",
    "@types/mocha": "10.0.10",
    "@types/node": "26.6.4",
    "@types/request": "2.48.13",
    "@types/rx": "4.1.4",
    "@types/ssh2": "1.15.6",
    "@types/stream-buffers": "3.0.8",
    "@types/tmp": "0.2.6",
    "@types/ws": "8.18.2",
    "@types/yargs": "17.0.35",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "chai": "6.3.0",
    "chai-as-promised": "8.0.2",
    "eslint": "10.12.0",
    "mocha": "12.0.3",
    "node-gyp": "13.1.0",
    "npm": "12.2.0",
    "nyc": "18.0.0",
