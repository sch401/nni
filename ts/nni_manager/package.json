    "express-ws": "5.0.2",
    "glob": "13.0.6",
    "http-proxy": "1.18.1",
    "ignore": "7.0.12",
    "js-base64": "3.9.4",
    "js-yaml": "5.4.2",
    "kubernetes-client": "9.0.0",
    "lockfile": "1.0.4",
    "python-shell": "5.0.0",
    "rx": "4.1.0",
    "sqlite3": "6.0.1",
    "ssh2": "1.17.0",
    "stream-buffers": "3.0.3",
    "tail-stream": "0.3.4",
    "tar": "7.5.22",
    "tree-kill": "1.2.2",
